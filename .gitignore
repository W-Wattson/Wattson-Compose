# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/
app/build/

# Local configuration file (sdk path, etc)
local.properties

# Android Studio
.idea/
*.iml
*.iws
*.ipr
.navigation/
captures/

# Keystore files (keep them out of VCS)
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.cxx/
.externalNativeBuild/

# Google Services (only if it contains API keys)
# google-services.json

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini

# Crash logs
crash-*.log

# Claude
.claude/
